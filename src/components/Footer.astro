---
import Pagination from '@astrojs/starlight/components/Footer.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
const links = [
  ['Free 4 Funs : À propos de', '/pages-wiki/free-4-funsa-propos-de/'],
  ["Free 4 Funs : Droits d'auteur", '/pages-wiki/free-4-funsdroits-dauteur/'],
  ['Free 4 Funs : Politique de confidentialité', '/pages-wiki/free-4-funspolitique-de-confidentialite/'],
];
---

<Pagination {...Astro.props} />

<nav class="f4f-footer-links">
  {links.map(([label, href], i) => (
    <>
      {i > 0 && ' · '}
      <a href={href}>{label}</a>
    </>
  ))}
</nav>

<style>
  .f4f-footer-links {
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .f4f-footer-links a {
    color: inherit;
  }
</style>