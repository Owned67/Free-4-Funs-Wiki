---
import { getCollection } from 'astro:content';
const docs = (await getCollection('docs'))
  .filter((d) => d.data.lastUpdated instanceof Date && d.id !== 'modifications-recentes')
  .sort((a, b) => b.data.lastUpdated - a.data.lastUpdated)
  .slice(0, 30);
---
<ul>
  {docs.map((d) => (
    <li>
      {d.data.lastUpdated.toLocaleDateString('fr-FR')} :
      <a href={`/${d.id.replace(/\.mdx?$/, '')}/`}>{d.data.title}</a>
    </li>
  ))}
</ul>